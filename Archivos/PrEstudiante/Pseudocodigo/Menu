  publico estatico vacio menuArchivoEstudiante()
    entero opE, idEstudiante
    Cadena nombreNuevo = ""
    hacer
      opE = leerEntero(menuArchivoE())
      segun (opE) hacer
        caso 1:
          imprimir("*******************************************\n")
          idEstudiante = leerEntero("Digite el ID del Estudiante a registrar: ")
          crudE.IngresarEstudiante(objArchivo, idEstudiante)
          romper
        caso 2:
          imprimir("*******************************************\n")
          imprimir("Los Registros del Archivo Estudiante son: \n" + crudE.Mostrar(objArchivo))
          romper
        caso 3:
          imprimir("*******************************************\n")
          idEstudiante = leerEntero("Digite el IDEstudiante del cliente a consultar: ")
          imprimir("El cliente consultado es:\n " + crudE.Consultar(objArchivo, idEstudiante).estructuraRegistro())
          romper
        caso 4:
          idEstudiante = leerEntero("ID a eliminar: ")
          imprimir(crudE.Eliminar(objArchivo, idEstudiante))
          romper
        caso 5:
          idEstudiante = leerEntero("ID a actualizar: ")
          crudE.Actualizar(objArchivo, idEstudiante)
          romper
        caso 6:
          imprimir("*******************************************\n")
          imprimir("Ingrese el nuevo nombre del archivo: ")
          nombreNuevo = leerConsolaLinea()
          objArchivo.renombrarArchivo(nombreNuevo + ".txt")
          romper
        caso 7:
          si (nombreNuevo.estaVacio()) entonces
            objArchivo.eliminaArchivo("datosEstudiante.txt")
          sino
            objArchivo.eliminaArchivo(nombreNuevo)
          FinSi
          romper
      FinSegun
    mientras (opE < 7)
  FinMetodo

