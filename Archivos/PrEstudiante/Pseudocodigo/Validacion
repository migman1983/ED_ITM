Clase Validacion

  publico estatico entero leerEntero(Cadena mensaje) // me permite validar el idCliente
    entero num = 0
    hacer
      Intentar
        imprimir(mensaje)
        num = leerConsolaEntero()
        si (num <= 0) entonces
          imprimir("ERROR, el Numero debe ser mayor que cero")
        FinSi
      Excepcion (Exception e)
        imprimir("ERROR:" + e)
      FinIntentar
    mientras (num <= 0)
    retornar num
  FinMetodo

  publico estatico Cadena leerTitulo(Cadena mensaje)
    entero p = 0
    Cadena programa = ""
    hacer
      Intentar
        imprimir(mensaje)
        p = leerConsolaEntero()
        segun (p) hacer
          caso 1:
            programa = "especialista"
            romper
          caso 2:
            programa = "magister"
            romper
          caso 3:
            programa = "doctor"
            romper
        FinSegun
        si (p < 1 o p > 3) entonces
          imprimir("ERROR, opción no valida")
        FinSi
      Excepcion (Exception e)
        imprimir("ERROR:" + e)
      FinIntentar
    mientras (p < 1 o p > 3)
    retornar programa
  FinMetodo

