clase Archivo 
    File archivo;//archivo logico
    FileReader lectura;//objeto para modo lectura del archivo
    BufferedReader buffer;//objeto que reserva un espacio en memoria donde se guarda la informacion
    BufferedWriter bufferW;
    BufferedReader buffernuevo;
    FileWriter escritura;//objeto para modo escritura del archivo
    PrintWriter impresion;//objeto para grabar directamente en el texto
	
    publico Cadena escribir(Cadena registro)//graba el texto se dice que lo imprime en el archivo
       Cadena mensaje="grabará un registro";
       intentar
        impresion.imprimir(registro);
       FinIntentar
        Atrapar(Exception objException)
         mensaje = objException.obtenerMensaje(); 
        FinAtrapar 
      retornar mensaje;
    FinMetodo
    
    publico Estudiante[] leerEstudiante()
      entero cl = contadorLineas("DatosEstudiante.txt");
      Estudiante vecE[];
      vecE = nuevo Estudiante[cl];
      Cadena registro;
      Cadena vec[] = nueva Cadena[6];
       intentar
         entero i = 0;
         mientras(cl>0)haga
          registro = buffer.readLine();
          cadena separador = convertirLiteral("|");
          vec = registro.Dividir(separador);
          entero codE = entero.parsearEntero(vec[0]);
          Cadena nombre = vec[1];
          Cadena apellido = vec[2];
          entero edad = entero.parsearEntero(vec[3]);
          entero estrato = entero.parsearEntero(vec[4]);
          real notaFinal = real.parsearReal(vec[5]);
          Estudiante objE = nuevo Estudiante (codE,nombre,apellido, edad,estrato, notaFinal);
          vecE[i] = objE;
          i++;
          cl--;  
        FinMientras
        buffer.cerrar();   
       FinIntentar
        Atrapar(Exception objException)
          objException.obtenerMensaje();          
        FinAtrapar
        retornar vecE;
    FinMetodo
    
  publico Cadena abrirModoLectura(Cadena ruta)
