    publico Cadena abrirModoEscritura(Cadena ruta)
       Cadena mensaje="¡El archivo se abrirá de Modo escritura!";
        intentar
            archivo = nuevo File(ruta);
            escritura= nuevo FileWriter(archivo,true);
            impresion = nuevo PrintWriter(escritura);
        FinIntentar
        Atrapar(Exception objException)
          mensaje = objException.obtenerMensaje();          
        FinAtrapar
        imprimir("mensaje método abrirModoEscritura: "+ mensaje);
       retornar mensaje;
    FinMetodo
    
    publico Cadena cerrarModoEscritura()
        Cadena mensaje="¡El archivo en **Modo escritura** se cierra!";
        intentar
          impresion.cerrar();
          buffer.cerrar();
         FinIntentar
        Atrapar(Exception objException)
         mensaje = objException.obtenerMensaje();          
        FinAtrapar
        retornar mensaje;
    FinMetodo

    publico booleano eliminaArchivo(Cadena ruta)
       imprimir("cual es el valor de Ruta:"+ruta);
       intentar
         archivo = nuevo File(ruta);
         Si(archivo.exists())entonces
          imprimir("****Archivo Eliminado****");
           imprimir("****: "+archivo.getAbsolutePath());
           archivo.Eliminar();
           archivo.EliminarAlSalir();
           retornar true;
          sino 
           retornar false;
         FinSi
	   FinIntentar 
	   FinAtrapar(Exception e)
        imprimir("ERROR: " + e.obtenerMensaje());
        retornar false;
       FinAtrapar
    FinMetodo
          
   publico entero contadorLineas(Cadena arch)
     entero numLineas=0;
     intentar
      archivo = nuevo File(arch);
       Si(archivo.isFile()== false)entonces
         retornar 0;  
        Sino
         lectura = nuevo FileReader(arch);
         BufferedReader br = nuevo BufferedReader(lectura);
         mientras (br.LectorLinea()!=null) 
          numLineas++;
         Finmientras
         br.cerrar();
        retornar numLineas;
	   FinSi
     FinIntentar
     Atrapar (IOException e)
       e.ImprimirRastreoPaquete();
     FinAtrapar
      retornar numLineas;
    Fin
     
   
   publico vacio renombrarArchivo( Cadena nuevoNombre)
    
      intentar
        Cadena nombreActual = "DatosEstudiante.txt";
        File oldfile = nuevo File(nombreActual);
        File nuevofile = nuevo File(nuevoNombre);
         Si (oldfile.renombrar(nuevofile))entonces
           imprimir("El archivo fue renombrado");
          sino 
            imprimir("no se puede renombrar el archivo");
         FinSi
      FinIntentar
	  Atrapar(Exception e)
       imprimir("***Archivo leído y cerrado correctamente*****"); 
      FinAtrapar
    FinMetodo
