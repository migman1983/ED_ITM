   //3. Creo el vector que va a almacenar los registros del archivo.
   Empleado[] vecE= new Empleados[cl]

   //4. paso los archivos del registro al vector.
   vecE= arch.leerEmpleados()

   //4.1 cierro el archivo en modo lectura, ya que ya tengo los datos en memoria
