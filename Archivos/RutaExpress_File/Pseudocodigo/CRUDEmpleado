   //Método Create  (Ingresar un nuevo registro de empleado)
   publico vacio ingresarRegistroEmpleado(Archivo arch, cadena cce)

  /*Validar que la cédula no se encuentre ya en el archivo: recorrer el arichivo , llevarlo a un vector de tipo Empleado,
   y recorrer ese vector para confirmar que la cédula ingresada no este ya registrada*/
  //DatosEmpleados.txt es el nombre del archivo 
  /*Cuenta cuantas líneas (registros/filas)  tiene el archivo actualmente. Ese número me dice el total 
  de clientes que ya existen*/
   entero cl= arch.contadorLineas("DatosEmpleados.txt")

    //Abro el archivo en modo lectura `para poder cargar los datos existentes
    arch.abrirModoLectura("DatosEmpleados.txt")

    //Creo vector de tamaño exacto (cl), según la cantidad de registros
    Empleado[] vecE= new Empleados[cl]
  
    //Paso todos los registros del archivo al vector
    vecE= arch.leerEmpleado()

    //Como ya cargue todos los datos en memoria, no necesito el archivo abierto
    arch.cerrarModoLectura()

    //Recorro el vector comparando la cédula recibida contra cada registro.
    /*Recorrer el vector comparando la cédula que quiere ingresar el usuario contra la cédula de cada empleado 
    ya guardado. Si encuentro una igual prendo la bandera Switch a VERDADERO y uso ROMPER para salir del ciclo inmediatamente,
    no tiene sendido seguir buscando si ya la encontre*/
    //Vbles de control para el recorrido
    entero i=0
    booleano sw = falso //SW= falso significa "cédula no encontrada"

    //Recorro el vector comparando la cédula recibida contra cada registro.
     mientras(i < cl) haga
         si(cce == vecE[i].obtenercce()) entonces
         sw = verdadero      //SW = verdadero significa "cédula de empleado encontrada", ya existe un empleado con esa cédula
     romper              //no sigo buscando, uso ROMPER para salir del ciclo inmediatamente, no tiene sendido seguir buscando si ya la encontre
        finsi
        i=i+1
     finmientras
 
    //Condicional: "Si NO se encontró la cédula (!SW) o el archivo está vacío (emp=0), entonces si puedo insertar el nuevo registro
    si(!sw || (cl == 0)) entonces

    /*1. Abrir el archivo en modo escritura para agregar e nuevo registro.
    arch.abrirArchivoModoEscritura("DatosEmpleados.txt)   

    /*2. Creo el objeto empleado y lo lleno con los datos recibidos (cce) cc=cedula ciudadanía empleado
    Empleado e= nuevo Empleado()
    e= e.ingresarDatos(cce)

    /*3.  Convierto el objeto "e" a una cadena de texto (formato para guardar en el .txt, los atribuos)/*
   cadena registro= e.convertirCadena()
   //Lo escribo como una nueva línea en el archivo
   arch.escribir(registro)

   //4. Cierro el archivo en modo escritura
   arch.cerrarModoEscritura()

      sino
   //Si la cédula ya existía, no se inserta nada y se le avisa al usuario
  imprimir("La cédula ya se encuentra registrada")
   finsi
finMetodo


