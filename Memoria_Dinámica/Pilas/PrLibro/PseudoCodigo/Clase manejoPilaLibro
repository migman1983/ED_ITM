publico real calculoPromedioPaginas(Pila objPila)
  Pila pilaAux = nueva Pila(objPila.obtenerSize())
  real acumPaginas = 0
  Libro l = nuevo Libro()
  mientras(objPila.isEmpty() == Falso)haga
     l = (Libro)objPila.pop()
     acumPaginas = acumPaginas + l.obtenerNumPaginas()
     pilaAux.push(l)
  fin Mientras
   devolverAux(pilaAux, objPila)
   retornar acumPaginas / objPila.obtenerSize()
 FinMetodo 
