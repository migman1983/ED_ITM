publico Pila crearJugadores( ) 
  Archivo objA = nuevo Archivo()
  Jugador j = nuevo Jugador()
  entero tamaño = 0
  escriba("ingrese el tamaño de la pila")
  lea tamaño
  Pila pila = nueva Pila(tamaño)
  Pila pilaAux = nueva Pila(tamaño)

  mientras(pila.isFull() == falso)haga
    j = j.ingresarDatos()
    pila.push(j)
  finMientras
  objA.abrirArchivoModoEscritura("Delanteros.txt")
  mientras(pila.isEmpty() == falso)haga
    j = (Jugador)pila.pop()
     si(j.obtenerPosicion()=="Delantero")entonces
        objA.escribir(j.toString())
       sino
        pilaAux.push(j) 
     finSi
  finMientras
    DevolverAux(pila, pilaAux)
    retornar pila
